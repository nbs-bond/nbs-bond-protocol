# ── Stellar Network ──────────────────────────────────────────────
STELLAR_NETWORK=testnet                        # testnet | mainnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_PUBLIC_KEY=G...                        # Admin public key (used by deploy scripts)

# ── Signer Keys (used by the API to build transactions) ──────────
ADMIN_SECRET_KEY=S...                          # Issuer/admin secret key
USER_SECRET_KEY=S...                           # Regular user (developer) secret key
INVESTOR_SECRET_KEY=S...                       # Investor secret key

# ── Contract Addresses (populated after deployment) ──────────────
# BOND_ISSUER_ADDRESS=C...
# COUPON_ENGINE_ADDRESS=C...
# ORACLE_CONSUMER_ADDRESS=C...
# DEX_ROUTER_ADDRESS=C...
# PROJECT_REGISTRY_ADDRESS=C...
# CREDIT_RETIREMENT_ADDRESS=C...

# ── IPFS / Pinata ────────────────────────────────────────────────
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=your_pinata_api_key
IPFS_SECRET_KEY=your_pinata_secret_key
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
IPFS_LOCAL_API_URL=http://localhost:5001/api/v0
REQUIRE_IPFS_PINNING=false

# ── Oracle ───────────────────────────────────────────────────────
# Whitelisted provider addresses allowed to submit reports
ORACLE_PROVIDER_WHITELIST=G...                 # Comma-separated list of provider addresses
DEFAULT_PROVIDER_ADDRESS=G...                  # Default provider used by the scheduler

# Upstream endpoints polled by the standalone oracle adapters (oracle/)
VERRA_REGISTRY_URL=https://registry.verra.org/api/v1
SATELLITE_API_URL=https://api.satellite-processor.io/v1
IOT_API_URL=https://api.iot-sensor-network.io/v1
BLUE_CARBON_API_URL=https://api.bluecarbon-observatory.io/v1

# Degradation alerting (oracle/health.ts) — fired when a provider turns degraded/down
ORACLE_ALERT_WEBHOOK=                          # Webhook URL (PagerDuty/Slack/OpsGenie); unset = log-only alerts
ORACLE_ALERT_COOLDOWN_MS=3600000               # Min interval between alerts per provider (default 1h)
ORACLE_ALERT_TIMEOUT_MS=2000                   # Fire-and-forget webhook POST timeout (default 2s)

# Dead-letter store for failed adapter runs (bounded; see oracle/dead-letter.ts)
ORACLE_DEAD_LETTER_FILE=.oracle-dead-letter.jsonl  # CLI store path (default cwd/.oracle-dead-letter.jsonl)
ORACLE_DEAD_LETTER_MAX_ENTRIES=1000            # Max records retained (default 1000)
ORACLE_DEAD_LETTER_TTL_MS=604800000            # CLI age bound per record (default 7d)
ORACLE_DEAD_LETTER_TTL_SECONDS=604800          # API scheduler Redis list TTL (default 7d)

# ── Authentication ───────────────────────────────────────────────
JWT_SECRET=your_very_long_jwt_secret_here
JWT_EXPIRY=7d
KYC_PROVIDER_URL=https://kyc.your-provider.com
KYC_API_KEY=your_kyc_api_key
# KYC status caching — per-state TTLs (seconds), circuit breaker, provider timeout
KYC_CACHE_TTL_APPROVED_SECONDS=3600               # verified/accredited (full TTL)
KYC_CACHE_TTL_PENDING_SECONDS=60                  # pending (short, reflects updates quickly)
KYC_CACHE_TTL_REJECTED_SECONDS=21600              # none/rejected (cached longer)
KYC_CIRCUIT_THRESHOLD=3                           # consecutive failures before the circuit opens
KYC_CIRCUIT_COOLDOWN_MS=30000                     # how long the circuit stays open before probing (half-open)
KYC_STALE_THRESHOLD_SECONDS=86400                 # max age of a stale fallback before KYC-gated ops are rejected
KYC_PROVIDER_TIMEOUT_MS=5000                      # per-request timeout for provider calls

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nbs_bond
REDIS_URL=redis://localhost:6379

# ── App ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
